def generate_project_name():
    while True:
        adj = random.choice(ADJECTIVES)
        sci = random.choice(SCIENTISTS)

        # The ultimate internal rule: Steve Wozniak is not boring!
        if adj == "boring" and sci == "wozniak":
            continue

        return f"{adj}_{sci}"


if __name__ == "__main__":
    # Generate 5 sample project root names
    print("Your randomized project root options:")
    for _ in range(5):
        print(f"📂 {generate_project_name()}")
