# Setup IBus
# ==========
# Some application does not work with global config, thus the alias.
IME=fcitx
export GTK_IM_MODULE="$IME"
export QT_IM_MODULE="$IME"
export QT4_IM_MODULE="$IME"
export XMODIFIERS=@im="$IME"
# alias teams="GTK_IM_MODULE=xim teams"
# alias chromium="GTK_IM_MODULE=xim chromium"

export QT_QPA_PLATFORMTHEME="qt6ct"
export XCURSOR_SIZE=48

# Scaling
# export GDK_DPI_SCALE=1.25
# export GDK_SCALE=1

# Libreoffice use QT theme
# ========================
export SAL_USE_VCLPLUGIN=kf5

# Helpful aliases
# ===============
alias ls="ls -h --color=auto"
alias l="ls -lh --color=auto"
alias feh="feh --scale-down"
alias gc='git commit -v'
alias gcm='git commit -v -m'
alias ga='git add'
alias gpsh='git push'
alias gpll='git pull'
alias gco='git pull'

# Locale
# ======
export LANG=en_US.UTF-8
export LANGUAGE=en_US.UTF-8
export LC_TIME=vi_VN.UTF-8
export LC_MEASUREMENT=vi_VN.UTF-8 # Use metric system
export LC_PAPER=vi_VN.UTF-8
export LC_TELEPHONE=vi_VN.UTF-8

# SSH to my phone
alias ssh-to-garnet='ssh -o Hostname=$(ip route show | grep default | awk "{print \$3}") garnet'

